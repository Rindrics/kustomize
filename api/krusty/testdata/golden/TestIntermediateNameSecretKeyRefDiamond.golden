apiVersion: apps/v1
kind: Deployment
metadata:
  name: project-app
spec:
  template:
    spec:
      containers:
      - name: app
        image: example.com/app:latest
        imagePullPolicy: Always
        env:
        - name: XQL_ZERO_ARG
          valueFrom:
            secretKeyRef:
              name: project-xql-zero-xql-secret-6khmtc56hm
              key: arg
        - name: XQL_ZERO_PASSWORD
          valueFrom:
            secretKeyRef:
              name: project-xql-zero-xql-secret-6khmtc56hm
              key: password
        - name: XQL_ONE_ARG
          valueFrom:
            secretKeyRef:
              name: project-xql-one-xql-secret-79mhmf5dgt
              key: arg
        - name: XQL_ONE_PASSWORD
          valueFrom:
            secretKeyRef:
              name: project-xql-one-xql-secret-79mhmf5dgt
              key: password
---
