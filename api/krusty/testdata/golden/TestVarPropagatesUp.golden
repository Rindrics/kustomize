apiVersion: v1
kind: Pod
metadata:
  name: circus
spec:
  containers:
  - name: ring
    image: ring
    command:
    - echo
    - base1-kelley
    - base2-grimaldi
    env:
    - name: P1
      value: base1-kelley
    - name: P2
      value: base2-grimaldi
---
apiVersion: v1
kind: Pod
metadata:
  name: base1-kelley
spec:
  containers:
  - name: smile
    image: smile
    command:
    - echo
    - base1-kelley
    env:
    - name: FOO
      value: base1-kelley
---
apiVersion: v1
kind: Pod
metadata:
  name: base2-grimaldi
spec:
  containers:
  - name: dance
    image: dance
    command:
    - echo
    - base2-grimaldi
    env:
    - name: FOO
      value: base2-grimaldi
