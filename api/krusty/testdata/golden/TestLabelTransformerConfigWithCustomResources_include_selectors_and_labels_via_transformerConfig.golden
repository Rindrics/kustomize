apiVersion: custom.example.org/v1
kind: SampleResource
metadata:
  name: sample-resource
  namespace: sample-namespace
  labels:
    environment: dev
    location: planet-earth
spec:
  template:
    spec:
      containers:
      - image: index.docker.io/library/hello-world
        env:
        - name: VARIABLE
          value: value
    metadata:
      labels:
        environment: dev
        location: planet-earth
  selectors:
    labels:
      environment: dev
      location: planet-earth
