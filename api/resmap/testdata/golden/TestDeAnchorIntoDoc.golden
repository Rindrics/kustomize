apiVersion: apps/v1
kind: Deployment
metadata:
  name: probes-test
spec:
  template:
    spec:
      readinessProbe:
        periodSeconds: 5
        timeoutSeconds: 3
        failureThreshold: 3
        httpGet:
          port: http
          path: /health
      livenessProbe:
        periodSeconds: 5
        timeoutSeconds: 3
        failureThreshold: 3
        httpGet:
          port: http
          path: /health
