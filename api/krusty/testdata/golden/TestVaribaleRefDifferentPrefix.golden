apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: base-dev-elasticsearch
spec:
  template:
    spec:
      containers:
      - name: elasticsearch
        env:
        - name: DISCOVERY_SERVICE
          value: base-dev-elasticsearch.monitoring.svc.cluster.local
---
apiVersion: v1
kind: Service
metadata:
  name: base-dev-elasticsearch
spec:
  ports:
  - name: transport
    port: 9300
    protocol: TCP
  clusterIP: None
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: base-test-elasticsearch
spec:
  template:
    spec:
      containers:
      - name: elasticsearch
        env:
        - name: DISCOVERY_SERVICE
          value: base-test-elasticsearch.monitoring.svc.cluster.local
---
apiVersion: v1
kind: Service
metadata:
  name: base-test-elasticsearch
spec:
  ports:
  - name: transport
    port: 9300
    protocol: TCP
  clusterIP: None
