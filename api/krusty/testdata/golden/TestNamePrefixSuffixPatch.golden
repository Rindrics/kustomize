apiVersion: v1
kind: ConfigMap
metadata:
  name: mysql-t7tt4cdbmf
data:
  HOST: everest
  MYSQL_DATABASE: db
  MYSQL_PASSWORD: correct horse battery staple
  MYSQL_USER: my-user
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: short-suffix
spec:
  template:
    spec:
      containers:
      - name: handler
        env:
        - valueFrom:
            configMapKeyRef:
              name: mysql-t7tt4cdbmf
              key: MYSQL_DATABASE
        envFrom:
        - configMapRef:
            name: mysql-t7tt4cdbmf
