apiVersion: apps/v1
kind: Deployment
metadata:
  name: staging-team-foo-nginx
  labels:
    app: mynginx
    org: example.com
    team: override-foo
    env: staging
  annotations:
    note: This is a test annotation
spec:
  template:
    metadata:
      labels:
        app: mynginx
        org: example.com
        team: override-foo
        env: staging
      annotations:
        note: This is a test annotation
    spec:
      containers:
      - name: nginx
        image: nginx
        volumeMounts:
        - name: nginx-persistent-storage
          mountPath: /tmp/ps
      volumes:
      - name: nginx-persistent-storage
        gcePersistentDisk:
          pdName: nginx-persistent-storage
      - configMap:
          name: staging-configmap-in-overlay-dc6fm46dhm
        name: configmap-in-overlay
      - configMap:
          name: staging-team-foo-configmap-in-base-hc6g9dk6g9
        name: configmap-in-base
  selector:
    matchLabels:
      app: mynginx
      org: example.com
      team: override-foo
      env: staging
---
apiVersion: v1
kind: Service
metadata:
  name: staging-team-foo-nginx
  labels:
    app: mynginx
    org: example.com
    team: override-foo
    env: staging
  annotations:
    note: This is a test annotation
spec:
  ports:
  - port: 80
  selector:
    app: mynginx
    org: example.com
    team: override-foo
    env: staging
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: staging-team-foo-configmap-in-base-hc6g9dk6g9
  labels:
    app: mynginx
    org: example.com
    team: override-foo
    env: staging
  annotations:
    note: This is a test annotation
data:
  foo: override-bar
---
apiVersion: v1
kind: Secret
metadata:
  name: staging-team-foo-secret-in-base-k2k4692t9g
  labels:
    app: mynginx
    org: example.com
    team: override-foo
    env: staging
  annotations:
    note: This is a test annotation
type: Opaque
data:
  password: c29tZXB3
  proxy: aGFwcm94eQ==
  username: YWRtaW4=
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: staging-configmap-in-overlay-dc6fm46dhm
  labels:
    env: staging
    team: override-foo
data:
  hello: world
