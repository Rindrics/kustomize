apiVersion: apps/v1
kind: Deployment
metadata:
  name: nginx
  labels:
    app: nginx
  annotations:
    config.kubernetes.io/origin: |
      configuredIn: gener.yaml
      configuredBy:
        kind: executable
        name: demo
    tshirt-size: small
spec:
  selector:
    matchLabels:
      app: nginx
  template:
    metadata:
      labels:
        app: nginx
    spec:
      containers:
      - name: nginx
        image: nginx
