apiVersion: apps/v1
kind: myCRD
metadata:
  name: deploy1
  namespace: ns1
spec:
  template:
    metadata:
      labels:
        old-label: old-value
        some-label: some-value
    spec:
      containers:
      - name: nginx
        env:
        - name: SOMEENV
          value: SOMEVALUE
---
apiVersion: apps/v1
kind: myCRD
metadata:
  name: deploy1
  namespace: ns2
spec:
  template:
    metadata:
      labels:
        old-label: old-value
        some-label: some-value
    spec:
      containers:
      - name: nginx
        env:
        - name: SOMEENV
          value: SOMEVALUE
