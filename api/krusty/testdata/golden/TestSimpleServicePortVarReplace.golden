apiVersion: v1
kind: Service
metadata:
  name: myService
spec:
  ports:
  - port: 8888
    targetPort: 8888
    name: grpc
---
apiVersion: apps/v1beta1
kind: StatefulSet
metadata:
  name: cockroachdb
spec:
  template:
    spec:
      containers:
      - name: cockroachdb
        image: cockroachdb/cockroach:v1.1.5
        ports:
        - containerPort: 26257
          name: grpc
        - containerPort: 8888
          name: http
