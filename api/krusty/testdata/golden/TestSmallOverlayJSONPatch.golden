apiVersion: apps/v1
kind: Deployment
metadata:
  name: a-myDeployment
  labels:
    app: myApp
spec:
  template:
    metadata:
      labels:
        backend: awesome
        app: myApp
    spec:
      containers:
      - name: whatever
        image: whatever
  selector:
    matchLabels:
      app: myApp
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app: myApp
  name: a-myService
spec:
  ports:
  - port: 7002
  selector:
    app: myApp
    backend: beagle
