apiVersion: apps/v1
kind: Deployment
metadata:
  name: my-deployment
  labels:
    my-label: my-namespace
  annotations:
    my-annotation: my-namespace
spec:
  template:
    spec:
      containers:
      - name: app
        image: busybox
---
apiVersion: v1
kind: Namespace
metadata:
  name: my-namespace
